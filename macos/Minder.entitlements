<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Optional entitlements for the hardened runtime. Use with
    MINDER_ENTITLEMENTS=macos/Minder.entitlements macos/make-app.sh
  disable-library-validation is only needed if a library in the bundle is not
  signed with the same Team ID as the app (it is not needed when everything is
  signed with one Developer ID, which make-app.sh does).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
