<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for TESTING an ad-hoc signed bundle under the hardened runtime.
    MINDER_ENTITLEMENTS=macos/Minder.entitlements macos/make-app.sh
  Ad-hoc signatures carry no Team ID, so the bundle's own libraries fail
  library validation without disable-library-validation.  That entitlement
  lets the app load unsigned libraries, so make-app.sh refuses to use this file
  with a Developer ID identity: a distributed build needs no entitlements.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
